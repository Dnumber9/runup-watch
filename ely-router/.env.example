# copy to .env on the machine that runs the router, then fill in
TELEGRAM_BOT_TOKEN=          # the same bot your alerts come from
TELEGRAM_CHAT_ID=            # your chat id (same as the watcher's)
PRIVATE_KEY=                 # a FRESH burner wallet made for this. Never your main wallet.
MAX_BUY_HYPE=5               # hard cap per trade
SLIPPAGE_BPS=1500            # 15%
HYPER_RPC=https://rpc.hyperliquid.xyz/evm
ELY_RPC=https://rpc-live.elysp.com
