# setup.sh writes .env for you. Only edit it on the VPS, never commit it.
TRADE_BOT_TOKEN=             # the new trade bot from @BotFather (alerts with ⚡ buttons come from it too)
OWNER_ID=                    # your Telegram user id (@userinfobot shows it); nobody else can use the bot
PRIVATE_KEY=                 # created on the VPS by: node router.mjs --new-wallet   (fresh burner only)
MAX_BUY_HYPE=5               # hard cap per buy (change any time with /set max)
SLIPPAGE_BPS=1500            # 15% (change with /set slip)
BUY_SIZES=0.5,1,2,5          # card buttons (change with /set sizes)
# ELY_RPCS=https://rpc.eleos.fun,https://rpc-live.boxa.club,https://rpc-live.elyspump.com,https://rpc-live.elysp.com
# Optional defaults (each one can also be changed from Telegram with /set or /auto)
# AUTO_SELL=off               # preset added to every buy, e.g. tp 2x 50 trail 40   (/auto)
# DEV_SELL_PCT=50             # sell all once the coin's creator dumps this % of their bag; 0 = off   (/set devsell)
# RUG_GUARD=on                # sell all when a held coin turns unsellable or its tax jumps   (/set rug)
# PRE_APPROVE=on              # approve right after a buy so every sell is one transaction   (/set preapprove)
# COPY_MAX_DAY=10             # copy-trade buys per day, all copied wallets together   (/set copymax)
